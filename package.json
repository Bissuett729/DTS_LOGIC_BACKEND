{
  "name": "cts_rack_scan_msft",
  "version": "1.0.0",
  "description": "Backend for Microsoft CTS",
  "author": "Miguel Angel Bissuett Lira",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "pm2:start:prod": "cross-env NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' pm2 start dist/main.js --name FPY_RACKTEST",
    "start:dev": "nest start --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:dev:stop": "clear && docker stop CTS_RACK_SCAN_MSFT_DEV",
    "docker:dev:delete": "clear && docker rm CTS_RACK_SCAN_MSFT_DEV",
    "docker:dev:start": "clear && docker start CTS_RACK_SCAN_MSFT_DEV",
    "docker:dev:restart": "clear && docker restart CTS_RACK_SCAN_MSFT_DEV",
    "docker:dev:exec": "clear && docker exec -it CTS_RACK_SCAN_MSFT_DEV sh",
    "docker:dev:logs": "clear && docker logs -f CTS_RACK_SCAN_MSFT_DEV",
    "docker:dev:build": "clear && docker compose --env-file .env -f docker/docker-compose.yml build --no-cache app_dev",
    "docker:dev:up": "clear && docker compose --env-file .env -f docker/docker-compose.yml up -d --build app_dev",
    "docker:dev:down": "clear && docker compose --env-file .env -f docker/docker-compose.yml down app_dev",
    "docker:prod:logs": "clear && docker logs -f CTS_RACK_SCAN_MSFT_PROD",
    "docker:prod:exec": "clear && docker exec -it CTS_RACK_SCAN_MSFT_PROD sh",
    "docker:prod:restart": "clear && docker restart CTS_RACK_SCAN_MSFT_PROD",
    "docker:prod:build": "clear && docker compose --env-file .env -f docker/docker-compose.yml build --no-cache app_prod",
    "docker:prod:start": "clear && docker compose --env-file .env -f docker/docker-compose.yml up -d app_prod",
    "docker:prod:up": "clear && docker compose --env-file .env -f docker/docker-compose.yml up -d --build app_prod",
    "docker:prod:down": "clear && docker compose --env-file .env -f docker/docker-compose.yml down app_prod"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.3.9",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/platform-socket.io": "^10.3.9",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/websockets": "^10.3.9",
    "adm-zip": "^0.5.16",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "chokidar": "^3.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "connect-timeout": "^1.9.0",
    "copyfiles": "^2.4.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "graphql": "^16.12.0",
    "image-size": "^2.0.2",
    "joi": "^17.13.1",
    "luxon": "^3.7.1",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.2",
    "nest-winston": "^1.10.0",
    "nestjs-pino": "^4.1.0",
    "nestjs-soap": "^3.0.2",
    "p-limit": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "soap": "^1.1.10",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "swagger-ui-dist": "^5.17.14",
    "unzipper": "^0.12.3",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^4.6.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.30",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": ".",
          "outputName": "junit.xml"
        }
      ]
    ]
  }
}
